{
  "info": {
    "name": "Hotel AI2 \u2014 OAuth2 permissions",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Start AI2 with AI_AUTH_MODE=oauth2. Obtain JWT access tokens from your identity provider, then set local token variables. Required issuer/audience and exact permissions claim are described in docs/AUTHENTICATION.md. Examples make no booking write; reader direct POST is expected to be denied."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "readerAccessToken",
      "value": ""
    },
    {
      "key": "bookerAccessToken",
      "value": ""
    },
    {
      "key": "chatAccessToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Missing token \u2192 401",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/chat",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"message\": \"Hello\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Reader search \u2192 read tools",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/chat",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{readerAccessToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"message\": \"Search availability at hotel h1 from 2027-04-10 to 2027-04-11 for 2 guests.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Reader direct booking denied \u2192 403",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/reservations",
        "header": [
          {
            "key": "Idempotency-Key",
            "value": "oauth-reader-denied-001"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{readerAccessToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 403\", () => pm.response.to.have.status(403));"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Booker without booking key \u2192 read tools",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/chat",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{bookerAccessToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"message\": \"Search availability at hotel h1 from 2027-04-10 to 2027-04-11 for 2 guests.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Booker with key \u2192 booking tool offered (search only)",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/chat",
        "header": [
          {
            "key": "Idempotency-Key",
            "value": "oauth-booking-demo-001"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{bookerAccessToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"message\": \"Search availability at hotel h1 from 2027-04-10 to 2027-04-11 for 2 guests.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "6. Chat-only token \u2192 no tools",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/chat",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{chatAccessToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"message\": \"Hello\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    }
  ]
}
